# GaMutual Environment Configuration
PROJECT_NAME="GaMutual Instagram Mutual & Unfollower Tracker"
VERSION="2.0.0"

# Database: SQLite for simple standalone dev or PostgreSQL for production
# DATABASE_URL=sqlite+aiosqlite:///./gamutual.db
DATABASE_URL=postgresql+asyncpg://gamutual:gamutual_secure_password@localhost:5432/gamutual

# Redis
REDIS_URL=redis://localhost:6379/0

# Security (Change in production)
SECRET_KEY=gamutual-super-secret-key-change-in-prod-aes256gcm

# Optional Residential Proxy (e.g., http://user:pass@proxy.example.com:8080)
INSTAGRAM_PROXY=
